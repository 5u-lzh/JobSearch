# JobLab Environment Variables
# Copy this file to .env and fill in your own values.
# NEVER commit your .env file to version control.

# Database (default: SQLite)
DATABASE_URL=sqlite:///data/joblab.db
# For MySQL:
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/joblab

# DeepSeek LLM (required for AI-powered analysis; falls back to rules if empty)
DEEPSEEK_API_KEY=your_deepseek_api_key
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat

# DashScope Embeddings (optional, for semantic search)
DASHSCOPE_API_KEY=your_dashscope_api_key
EMBEDDING_MODEL_NAME=text-embedding-v4

# AnySearch (optional, for web search)
ANYSEARCH_API_KEY=your_anysearch_api_key

# Tavily (optional, alternative web search)
TAVILY_API_KEY=your_tavily_api_key

# Utility model for lightweight tasks (default: deepseek-chat)
UTILITY_MODEL_NAME=deepseek-chat

# Debug: set to "true" to echo SQL statements
# SQL_ECHO=false
